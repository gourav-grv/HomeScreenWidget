        <resource-file src="res/android/xml/hswd_info_focus.xml" target="res/xml/hswd_info_focus.xml" />
        <resource-file src="res/android/layout/hswd_weather_clock.xml" target="res/layout/hswd_weather_clock.xml" />
        <resource-file src="res/android/xml/hswd_info_weather_clock.xml" target="res/xml/hswd_info_weather_clock.xml" />
        <resource-file src="res/android/layout/hswd_dashboard.xml" target="res/layout/hswd_dashboard.xml" />
        <resource-file src="res/android/xml/hswd_info_dashboard.xml" target="res/xml/hswd_info_dashboard.xml" />
        <resource-file src="res/android/layout/hswd_game_mode.xml" target="res/layout/hswd_game_mode.xml" />
        <resource-file src="res/android/xml/hswd_info_game_mode.xml" target="res/xml/hswd_info_game_mode.xml" />
        <resource-file src="res/android/values/hswd_strings.xml" target="res/values/hswd_strings.xml" />
        <!-- HSW-DEMOS-END -->
    </platform>

    <!-- ===================================================== iOS -->
    <platform name="ios">
        <!-- App Group defaults to group.<bundle id> (override with preference HSWAppGroup);
             optional preference HSWWidgetProfile = provisioning profile of the widget extension. -->
        <config-file target="config.xml" parent="/*">
            <feature name="HomeScreenWidget">
                <param name="ios-package" value="HomeScreenWidgetPlugin" />
                <param name="onload" value="true" />
            </feature>
            <preference name="SwiftVersion" value="5" />
        </config-file>

        <!-- URL scheme used by widget taps to reach the app: hsw-<app id>://action?a=... -->
        <config-file target="*-Info.plist" parent="CFBundleURLTypes">
            <array>
                <dict>
                    <key>CFBundleURLName</key>
                    <string>hsw-widget</string>
                    <key>CFBundleURLSchemes</key>
                    <array>
                        <string>hsw-$PACKAGE_NAME</string>
                    </array>
                </dict>
            </array>
        </config-file>

        <source-file src="src/ios/HomeScreenWidgetPlugin.swift" />
        <framework src="WidgetKit.framework" weak="true" />

        <hook type="after_prepare" src="hooks/ios/add_widget_extension.js" />
    </platform>
</plugin>
