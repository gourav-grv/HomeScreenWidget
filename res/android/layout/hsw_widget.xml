<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hsw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hsw_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/hsw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hsw_accent"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="#1068EB" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hsw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hsw_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#5F6368"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hsw_count_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hsw_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1068EB"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hsw_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5F6368"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/hsw_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/hsw_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#80868B"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/hsw_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#80868B"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
