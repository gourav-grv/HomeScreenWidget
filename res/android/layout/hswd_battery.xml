<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/hswd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hswd_bg_dark"
    android:padding="14dp"
    android:gravity="center_vertical">
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp">
        <ProgressBar
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:max="100"
            android:progress="76"
            android:indeterminate="false"
            android:progressDrawable="@drawable/hswd_ring_mint" />
        <TextView
            android:text="⚡ 76%"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:padding="10dp"
        android:background="@drawable/hswd_tile_light"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:text="📱 My Phone"
                android:textSize="12sp"
                android:textColor="#111827"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:text=""
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:text="76%"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="76"
            android:indeterminate="false"
            android:progressDrawable="@drawable/hswd_bar_green"
            android:layout_marginTop="3dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:text="⌚ Watch"
                android:textSize="12sp"
                android:textColor="#111827"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:text=""
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:text="93%"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="93"
            android:indeterminate="false"
            android:progressDrawable="@drawable/hswd_bar_green"
            android:layout_marginTop="3dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:text="🎧 Buds"
                android:textSize="12sp"
                android:textColor="#111827"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:text=""
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:text="100%"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="100"
            android:indeterminate="false"
            android:progressDrawable="@drawable/hswd_bar_green"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
