<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/hswd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hswd_bg_dark"
    android:padding="14dp"
    android:gravity="center_vertical">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">
        <TextView
            android:text="Today"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:text="✅ 2/5 Tasks"
                android:textSize="12sp"
                android:textColor="#E5E7EB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:text="   📅 1 Meeting"
                android:textSize="12sp"
                android:textColor="#E5E7EB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:text="⏰ 1 Reminder"
                android:textSize="12sp"
                android:textColor="#E5E7EB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:text="   ✉ 12 Emails"
                android:textSize="12sp"
                android:textColor="#E5E7EB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">
        <ProgressBar
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:max="100"
            android:progress="40"
            android:indeterminate="false"
            android:progressDrawable="@drawable/hswd_ring_cyan" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="40%"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:text="Productivity"
                android:textSize="8sp"
                android:textColor="#CBD5E1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
