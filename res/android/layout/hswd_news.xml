<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/hswd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hswd_bg_white"
    android:padding="14dp"
    android:gravity="center_vertical">
    <TextView
        android:text="🏔"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="@drawable/hswd_bg_news_img"
        android:maxLines="2"
        android:ellipsize="end" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_height="wrap_content">
        <TextView
            android:text="Top Stories"
            android:textSize="13sp"
            android:textColor="#111827"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:text="Snowfall brings early winter to the hills"
            android:textSize="13sp"
            android:textColor="#374151"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:text=""
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:text="→"
                android:textSize="14sp"
                android:textColor="#6366F1"
                android:gravity="center"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/hswd_chip_accent"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
